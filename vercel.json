{
  "buildCommand": "npm install dotenv && npm run build",
  "outputDirectory": "dist/public",
  "env": {
    "NODE_OPTIONS": "--no-deprecation"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}